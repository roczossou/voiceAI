# Variables d'environnement du service Django.
# En local, rien n'est requis : sans ces variables, les réglages de
# développement d'origine s'appliquent (DEBUG=True, SQLite, CORS localhost:5173).
# Sur Render, elles sont définies dans le dashboard / render.yaml.

# Obligatoire en production. Générer une valeur longue et aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Par défaut : True en local, False sur Render (détecté via la variable RENDER).
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules. Sur Render, le domaine
# *.onrender.com est ajouté automatiquement (RENDER_EXTERNAL_HOSTNAME) ;
# n'ajouter ici que le domaine personnalisé final.
DJANGO_ALLOWED_HOSTS=

# Base de données PostgreSQL (Neon). Vide → repli sur le SQLite local
# (backend/back/db.sqlite3). Ce fichier .env est lu automatiquement par
# settings.py (python-dotenv) ; l'environnement réel reste prioritaire.
DATABASE_URL=postgresql://user:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Curseurs côté serveur. Détecté automatiquement (désactivés si l'URL contient
# « pooler », le PgBouncer de Neon ne les supportant pas en mode transaction).
DJANGO_DISABLE_SERVER_SIDE_CURSORS=

# Origines du frontend autorisées à appeler l'API (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origines autorisées à se connecter à l'admin Django derrière HTTPS.
CSRF_TRUSTED_ORIGINS=

# Dossier des fichiers téléversés. Sur Render avec disque : /var/data/media
DJANGO_MEDIA_ROOT=

# Redirection HTTPS applicative. À laisser false sur Render (le proxy s'en
# charge et le health check interne échouerait sur une redirection).
DJANGO_SECURE_SSL_REDIRECT=

# HSTS en secondes. 0 = désactivé. Ne l'activer (31536000) qu'une fois le
# domaine définitif servi exclusivement en HTTPS.
DJANGO_HSTS_SECONDS=0

# Création automatique du compte back-office au premier build.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Charge main/fixtures/contenu.json au build. À repasser à false juste après
# le premier déploiement (sinon les modifications du back-office sont écrasées).
LOAD_INITIAL_DATA=false
